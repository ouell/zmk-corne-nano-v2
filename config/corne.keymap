#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

// Key positions (Corne 6 col): rows 0-11, 12-23, 24-35, thumbs 36-41
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35
#define THUMBS 36 37 38 39 40 41

/ {
    behaviors {
        // "Timeless" home row mods (urob/zmk-config): a mod only triggers when
        // the other key is on the opposite hand or a thumb, so fast same-hand
        // rolls always resolve as taps.
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";

            // -----------------------------------------------------------------------------
            // |  TAB  |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | BSPC |
            // | SHIFT |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '   |
            // |  (hold)  CTRL  OPT   CMD  SHIFT       |       SHIFT  CMD  OPT  CTRL          |
            // | CTRL  |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | ESC  |
            //                     | CMD | LWR | SPC |   | ENT | RSE | OPT |

            bindings = <
&kp TAB    &kp Q        &kp W       &kp E       &kp R        &kp T        &kp Y    &kp U        &kp I       &kp O       &kp P            &kp BSPC
&kp LSHFT  &hml LCTRL A &hml LALT S &hml LGUI D &hml LSHFT F &kp G        &kp H    &hmr LSHFT J &hmr LGUI K &hmr LALT L &hmr LCTRL SEMI  &kp SQT
&kp LCTRL  &kp Z        &kp X       &kp C       &kp V        &kp B        &kp N    &kp M        &kp COMMA   &kp DOT     &kp FSLH         &kp ESC
                                    &kp LGUI    &mo 1        &kp SPACE    &kp RET  &mo 2        &kp LALT
            >;
        };

        lower_layer {
            display-name = "Lower Layer";

            // -----------------------------------------------------------------------------
            // | ESC |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // |     |  !  |  +  |  -  |  =  |  ~  |   |  _  |  (  |  )  |  {  |  }  |  |   |
            // |     |  ^  |  *  |  #  |  %  |  @  |   |  [  |  ]  |     |     |  \  |      |
            //                   | CMD |     | SPC |   | ENT |     | OPT |

            bindings = <
&kp ESCAPE  &kp N1     &kp N2     &kp N3     &kp N4       &kp N5       &kp N6            &kp N7                &kp N8                 &kp N9          &kp N0           &kp BSPC
&trans      &kp EXCL   &kp PLUS   &kp MINUS  &kp EQUAL    &kp TILDE    &kp UNDER         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp PIPE
&trans      &kp CARET  &kp ASTRK  &kp HASH   &kp PERCENT  &kp AT       &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &trans                 &trans          &kp BACKSLASH    &trans
                                  &kp LGUI   &trans       &kp SPACE    &kp RET           &trans                &kp LALT
            >;
        };

        raise_layer {
            display-name = "Raise Layer";

            // -----------------------------------------------------------------------------
            // | ESC | F5  | F6  | F7  | F8  | F9  |   | C-← | C-→ |C-O-←|C-O-→|C-O-R | BSPC |
            // |     | F10 | F11 | F12 |     |     |   |  ←  |  ↓  |  ↑  |  →  |      |      |
            // |     |     |     |     |     |     |   |     |     |     |     |      |      |
            //                   | CMD |     | SPC |   | ENT |     | OPT |

            bindings = <
&kp ESCAPE  &kp F5   &kp F6   &kp F7    &kp F8  &kp F9       &kp LC(LEFT)  &kp LC(RIGHT)  &kp LC(LA(LEFT))  &kp LC(LA(RIGHT))  &kp LC(LA(R))  &kp BSPC
&trans      &kp F10  &kp F11  &kp F12   &none   &none        &kp LEFT      &kp DOWN       &kp UP_ARROW      &kp RIGHT_ARROW    &none          &none
&trans      &none    &none    &none     &none   &none        &none         &none          &none             &none              &none          &none
                              &kp LGUI  &trans  &kp SPACE    &kp RET       &trans         &kp LALT
            >;
        };

        adjust_layer {
            display-name = "Adjust Layer";

            // LWR + RSE
            // -----------------------------------------------------------------------------
            // |BTCLR| BT0 | BT1 | BT2 | BT3 | BT4 |   |     |     |     |     |     |      |
            // |RESET| USB | BLE |     |     |     |   |PREV |VOL- |VOL+ |NEXT |PLAY |RESET |
            // |BOOT |     |     |     |     |     |   |     |MUTE |     |     |     | BOOT |
            //                   |     |     |     |   |     |     |     |

            bindings = <
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none      &none         &none            &none       &none   &none
&sys_reset   &out OUT_USB  &out OUT_BLE  &none         &none         &none           &kp C_PREV &kp C_VOL_DN  &kp C_VOLUME_UP  &kp C_NEXT  &kp C_PP  &sys_reset
&bootloader  &none         &none         &none         &none         &none           &none      &kp C_MUTE    &none            &none       &none   &bootloader
                                         &trans        &trans        &none           &none      &trans        &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
